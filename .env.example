# Activity provider: phabricator or git.
DEVFEEDBACKAI_PROVIDER=git

# Used by the git provider. Leave as "." to use the current directory.
DEVFEEDBACKAI_GIT_REPO=.

# Optional comma-separated developer selectors.
# Phabricator expects usernames. Git accepts author names, emails, or "Name <email>".
DEVFEEDBACKAI_USERS=

# Optional comma-separated Phabricator project/team names.
DEVFEEDBACKAI_TEAMS=

# Command used to generate feedback. The prompt is appended as the final argument.
DEVFEEDBACKAI_MODEL_COMMAND=claude -p
